# ==========================================
# Worker Service Environment Configuration
# ==========================================

# Core Runtime Environment
NODE_ENV=production

# Database (Neon / Supabase / AWS RDS PostgreSQL pooled connection string)
DATABASE_URI=postgresql://username:password@ep-pooler-example.us-east-2.aws.neon.tech/analytics_dashboard?sslmode=require

# Redis Connection (Upstash Redis TLS connection string or Redis Cloud)
REDIS_URL=rediss://default:your-strong-redis-password@your-upstash-instance.upstash.io:6379

# AI Model Provider API Keys
GEMINI_API_KEY=AIzaSyYourGeminiApiKeyHere
ANTHROPIC_API_KEY=sk-ant-api03-YourAnthropicApiKeyHere
ANTHROPIC_MODEL=claude-sonnet-5

# S3 / Cloudflare R2 Object Storage
S3_BUCKET=treelife-analytics-media
S3_REGION=auto
S3_ACCESS_KEY_ID=your-s3-or-r2-access-key-id
S3_SECRET_ACCESS_KEY=your-s3-or-r2-secret-access-key
S3_ENDPOINT=https://your-account-id.r2.cloudflarestorage.com
S3_PREFIX=media
S3_FORCE_PATH_STYLE=false
