NODE_ENV=development
PORT=3000
PUBLIC_APP_URL=http://localhost:3000

DATABASE_URI=postgresql://postgres:postgres@localhost:5432/analytics_dashboard
REDIS_URL=redis://localhost:6379

PAYLOAD_SECRET=REPLACE_WITH_LONG_RANDOM_SECRET

ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=REPLACE_WITH_ADMIN_PASSWORD

GEMINI_API_KEY=REPLACE_WITH_GEMINI_KEY
GEMINI_MODEL=gemini-3.6-flash
GEMINI_RETRY_MODEL=gemini-3.1-pro-preview
ANTHROPIC_API_KEY=REPLACE_WITH_ANTHROPIC_KEY
# Chat (apps/web/lib/claudeChatClient.ts) and prompt-edit
# (apps/web/lib/claudeConfigEditClient.ts) share these.
ANTHROPIC_MODEL=claude-sonnet-5
ANTHROPIC_RETRY_MODEL=claude-opus-5
# Section 9.1: initial config generation (worker/src/services/claudeConfig.ts)
# reads its own pair, deliberately not ANTHROPIC_MODEL above, so it can run a
# different tier than chat/prompt-edit without moving either of those too.
ANTHROPIC_CONFIG_MODEL=claude-opus-5
ANTHROPIC_CONFIG_RETRY_MODEL=claude-opus-5

UPLOAD_MAX_SIZE_MB=25
MAX_ROWS_PER_TABLE=10000
MAX_TOTAL_ROWS=25000
MAX_TABLES_PER_FILE=25
